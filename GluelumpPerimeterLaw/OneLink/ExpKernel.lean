import YangMills.Gauge.LinkReflectionPositivity

/-!
# Finite-coordinate exponential reflection kernels

This file is the lattice-independent analytic core of the all-coupling
one-link argument.  A finite-dimensional feature space is represented by a
finite family of complex coordinates.  This is equivalent to choosing an
orthonormal basis in the tensor formulation of the roadmap, and agrees
literally with the matrix-coordinate feature family already used by link
reflection positivity.

For a finite feature family `feature : A → C(X, ℂ)`, the kernel

`exp (alpha * ∑ a, conj (feature a x) * feature a y)`

has an exact expansion as a sum of squared feature-word moments.  All
interchanges of Taylor series and Haar integration are justified by normal
convergence in the uniform norm.  No lattice, group, or small-coupling
assumption occurs here.
-/

namespace YangMills.Gluelump.OneLink

open MeasureTheory
open scoped BigOperators ComplexConjugate Topology

noncomputable section

universe u v

variable {X : Type u} {A : Type v}
  [TopologicalSpace X]
  [Fintype A]

/-- A labelled word in a finite family of complex features. -/
abbrev FeatureWord (A : Type*) (m : ℕ) := Fin m → A

/-- Product of the feature coordinates selected by a word. -/
def featureMonomial (feature : A → C(X, ℂ)) {m : ℕ}
    (w : FeatureWord A m) : C(X, ℂ) :=
  ∏ r, feature (w r)

@[simp]
theorem featureMonomial_apply (feature : A → C(X, ℂ)) {m : ℕ}
    (w : FeatureWord A m) (x : X) :
    featureMonomial feature w x = ∏ r, feature (w r) x := by
  simp [featureMonomial]

/-- The finite rank-one kernel generated by the feature coordinates. -/
def featureKernel (feature : A → C(X, ℂ)) : C(X × X, ℂ) :=
  ∑ a, star ((feature a).comp ContinuousMap.fst) *
    (feature a).comp ContinuousMap.snd

@[simp]
theorem featureKernel_apply (feature : A → C(X, ℂ)) (z : X × X) :
    featureKernel feature z =
      ∑ a, conj (feature a z.1) * feature a z.2 := by
  simp [featureKernel]

/-- Powers of a finite rank-one kernel are sums over labelled words. -/
theorem featureKernel_pow_eq_sum_words
    (feature : A → C(X, ℂ)) (m : ℕ) (z : X × X) :
    featureKernel feature z ^ m =
      ∑ w : FeatureWord A m,
        conj (featureMonomial feature w z.1) *
          featureMonomial feature w z.2 := by
  rw [featureKernel_apply, Fintype.sum_pow]
  apply Finset.sum_congr rfl
  intro w _hw
  simp only [featureMonomial_apply, map_prod, ← Finset.prod_mul_distrib]

/-- The exponential reflection kernel at coupling `alpha`. -/
def expFeatureKernel (alpha : ℝ) (feature : A → C(X, ℂ)) :
    C(X × X, ℂ) where
  toFun z := Complex.exp ((alpha : ℂ) * featureKernel feature z)
  continuous_toFun := Complex.continuous_exp.comp <|
    continuous_const.mul (featureKernel feature).continuous

@[simp]
theorem expFeatureKernel_apply (alpha : ℝ)
    (feature : A → C(X, ℂ)) (z : X × X) :
    expFeatureKernel alpha feature z =
      Complex.exp ((alpha : ℂ) * featureKernel feature z) := by
  rfl

/-- Real part of a finite feature kernel, packaged as a real continuous
kernel.  For doubled Wilson features the imaginary part vanishes exactly. -/
def reFeatureKernel (feature : A → C(X, ℂ)) : C(X × X, ℝ) where
  toFun z := (featureKernel feature z).re
  continuous_toFun := Complex.continuous_re.comp (featureKernel feature).continuous

/-- Real exponential kernel associated with the real part of a feature
kernel. -/
def realExpFeatureKernel (alpha : ℝ) (feature : A → C(X, ℂ)) :
    C(X × X, ℝ) where
  toFun z := Real.exp (alpha * reFeatureKernel feature z)
  continuous_toFun := Real.continuous_exp.comp <|
    continuous_const.mul (reFeatureKernel feature).continuous

@[simp]
theorem realExpFeatureKernel_apply (alpha : ℝ)
    (feature : A → C(X, ℂ)) (z : X × X) :
    realExpFeatureKernel alpha feature z =
      Real.exp (alpha * (featureKernel feature z).re) :=
  rfl

/-- When the doubled feature kernel is real, its complex exponential is
literally the complexification of `realExpFeatureKernel`. -/
theorem expFeatureKernel_eq_of_im_zero (alpha : ℝ)
    (feature : A → C(X, ℂ)) (z : X × X)
    (him : (featureKernel feature z).im = 0) :
    expFeatureKernel alpha feature z =
      (realExpFeatureKernel alpha feature z : ℂ) := by
  rw [expFeatureKernel_apply, realExpFeatureKernel_apply]
  have hreal : featureKernel feature z =
      ((featureKernel feature z).re : ℂ) := by
    apply Complex.ext
    · simp
    · simpa using him
  rw [hreal]
  simp only [Complex.ofReal_re]
  rw [← Complex.ofReal_mul, Complex.ofReal_exp]

theorem realExpFeatureKernel_pos (alpha : ℝ)
    (feature : A → C(X, ℂ)) (z : X × X) :
    0 < realExpFeatureKernel alpha feature z :=
  Real.exp_pos _

/-- A pointwise real-kernel bound exponentiates monotonically at
nonnegative coupling. -/
theorem realExpFeatureKernel_le_exp
    {alpha B : ℝ} (halpha : 0 ≤ alpha)
    (feature : A → C(X, ℂ)) (z : X × X)
    (hbound : (featureKernel feature z).re ≤ B) :
    realExpFeatureKernel alpha feature z ≤ Real.exp (alpha * B) := by
  rw [realExpFeatureKernel_apply]
  exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hbound halpha)

/-- The factor outside the exponential kernel in a reflected pairing. -/
def featureSideFactor (f h : C(X, ℂ)) : C(X × X, ℂ) :=
  star (f.comp ContinuousMap.fst) * h.comp ContinuousMap.snd

@[simp]
theorem featureSideFactor_apply (f h : C(X, ℂ)) (z : X × X) :
    featureSideFactor f h z = conj (f z.1) * h z.2 := by
  simp [featureSideFactor]

/-- Degree-`m` Taylor integrand for the exponential feature kernel. -/
def featureTaylorIntegrand (alpha : ℝ) (feature : A → C(X, ℂ))
    (f h : C(X, ℂ)) (m : ℕ) : C(X × X, ℂ) :=
  featureSideFactor f h *
    ((m.factorial : ℂ)⁻¹ • ((alpha : ℂ) • featureKernel feature) ^ m)

/-- The normally convergent Taylor integrands sum pointwise to the
exponential-kernel integrand. -/
theorem tsum_featureTaylorIntegrand_apply
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f h : C(X, ℂ))
    (z : X × X) :
    (∑' m : ℕ, featureTaylorIntegrand alpha feature f h m z) =
      featureSideFactor f h z * expFeatureKernel alpha feature z := by
  rw [expFeatureKernel_apply, Complex.exp_eq_exp_ℂ]
  refine HasSum.congr_fun
    ((NormedSpace.expSeries_div_hasSum_exp
      ((alpha : ℂ) * featureKernel feature z)).mul_left
        (featureSideFactor f h z)) (fun m ↦ ?_) |>.tsum_eq
  change featureSideFactor f h z *
      ((m.factorial : ℂ)⁻¹ *
        (((alpha : ℂ) * featureKernel feature z) ^ m)) = _
  simp only [div_eq_mul_inv]
  ring

variable [CompactSpace X]

/-- Uniform normal summability of the Taylor integrands. -/
theorem summable_norm_featureTaylorIntegrand
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f h : C(X, ℂ)) :
    Summable fun m ↦ ‖featureTaylorIntegrand alpha feature f h m‖ := by
  let K : C(X × X, ℂ) := (alpha : ℂ) • featureKernel feature
  have hExp : Summable fun m : ℕ ↦
      ‖(m.factorial : ℂ)⁻¹ • K ^ m‖ :=
    NormedSpace.norm_expSeries_summable' K
  have hmajor : Summable fun m : ℕ ↦
      ‖featureSideFactor f h‖ * ‖(m.factorial : ℂ)⁻¹ • K ^ m‖ :=
    Summable.mul_left _ hExp
  refine hmajor.of_nonneg_of_le (fun m ↦ norm_nonneg _) (fun m ↦ ?_)
  exact norm_mul_le _ _

variable [MeasurableSpace X] [BorelSpace X] [SecondCountableTopology X]
  (μ : Measure X) [IsProbabilityMeasure μ]

/-- Feature-word moment against a finite measure. -/
def featureMoment (feature : A → C(X, ℂ))
    (f : C(X, ℂ)) {m : ℕ} (w : FeatureWord A m) : ℂ :=
  ∫ x, f x * featureMonomial feature w x ∂μ

/-- Normal convergence permits termwise integration against `μ × μ`. -/
theorem tsum_integral_featureTaylorIntegrand
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f h : C(X, ℂ)) :
    (∑' m : ℕ, ∫ z, featureTaylorIntegrand alpha feature f h m z
        ∂μ.prod μ) =
      ∫ z, ∑' m : ℕ, featureTaylorIntegrand alpha feature f h m z
        ∂μ.prod μ := by
  apply integral_tsum_of_summable_integral_norm
  · intro m
    exact (featureTaylorIntegrand alpha feature f h m).continuous
      |>.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  · have hnorm := summable_norm_featureTaylorIntegrand alpha feature f h
    refine hnorm.of_nonneg_of_le
      (fun m ↦ integral_nonneg fun _ ↦ norm_nonneg _) (fun m ↦ ?_)
    calc
      ∫ z, ‖featureTaylorIntegrand alpha feature f h m z‖ ∂μ.prod μ ≤
          ∫ _z, ‖featureTaylorIntegrand alpha feature f h m‖ ∂μ.prod μ := by
        apply integral_mono
        · exact (featureTaylorIntegrand alpha feature f h m).continuous.norm
            |>.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
        · exact integrable_const _
        · intro z
          exact (featureTaylorIntegrand alpha feature f h m).norm_coe_le_norm z
      _ = ‖featureTaylorIntegrand alpha feature f h m‖ := by simp

/-- Fubini factorization for one feature word. -/
theorem integral_featureWord_eq_moments
    (feature : A → C(X, ℂ)) (f h : C(X, ℂ)) {m : ℕ}
    (w : FeatureWord A m) :
    (∫ z : X × X,
      featureSideFactor f h z *
        (conj (featureMonomial feature w z.1) *
          featureMonomial feature w z.2) ∂μ.prod μ) =
      conj (featureMoment μ feature f w) *
        featureMoment μ feature h w := by
  let leftFactor : X → ℂ := fun x ↦
    conj (f x * featureMonomial feature w x)
  let rightFactor : X → ℂ := fun x ↦
    h x * featureMonomial feature w x
  have hpoint : ∀ z : X × X,
      featureSideFactor f h z *
          (conj (featureMonomial feature w z.1) *
            featureMonomial feature w z.2) =
        leftFactor z.1 * rightFactor z.2 := by
    intro z
    simp only [featureSideFactor_apply, leftFactor, rightFactor, map_mul]
    ring
  simp_rw [hpoint]
  rw [integral_prod_mul leftFactor rightFactor]
  rw [show (∫ x, leftFactor x ∂μ) =
      conj (featureMoment μ feature f w) by
    change (∫ x, conj (f x * featureMonomial feature w x) ∂μ) = _
    rw [integral_conj]
    rfl]
  rfl

/-- An integrated Taylor coefficient is a finite Gram sum of moments. -/
theorem integral_featureTaylorIntegrand_eq_gram
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f h : C(X, ℂ)) (m : ℕ) :
    (∫ z, featureTaylorIntegrand alpha feature f h m z ∂μ.prod μ) =
      (((alpha ^ m / m.factorial : ℝ) : ℂ) *
        ∑ w : FeatureWord A m,
          conj (featureMoment μ feature f w) *
            featureMoment μ feature h w) := by
  have hpoint (z : X × X) :
      featureTaylorIntegrand alpha feature f h m z =
        (((alpha ^ m / m.factorial : ℝ) : ℂ) *
          ∑ w : FeatureWord A m,
            featureSideFactor f h z *
              (conj (featureMonomial feature w z.1) *
                featureMonomial feature w z.2)) := by
    change featureSideFactor f h z *
        ((m.factorial : ℂ)⁻¹ *
          (((alpha : ℂ) * featureKernel feature z) ^ m)) = _
    rw [mul_pow, featureKernel_pow_eq_sum_words]
    rw [← Finset.mul_sum]
    push_cast
    ring
  simp_rw [hpoint]
  rw [integral_const_mul, integral_finsetSum Finset.univ]
  · apply congrArg ((((alpha ^ m / m.factorial : ℝ) : ℂ)) * ·)
    apply Finset.sum_congr rfl
    intro w _hw
    exact integral_featureWord_eq_moments μ feature f h w
  · intro w _hw
    exact ((featureSideFactor f h).continuous.mul
      ((Complex.continuous_conj.comp
        ((featureMonomial feature w).continuous.comp continuous_fst)).mul
        ((featureMonomial feature w).continuous.comp continuous_snd)))
      |>.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

/-- Exact finite-coordinate exponential-kernel moment expansion.  This is the
coordinate form of `expInner_kernel_eq_tsum_moment_normSq` from the roadmap. -/
theorem expFeatureKernel_pairing_eq_tsum_moments
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f h : C(X, ℂ)) :
    (∫ z : X × X,
      featureSideFactor f h z * expFeatureKernel alpha feature z
        ∂μ.prod μ) =
      ∑' m : ℕ, (((alpha ^ m / m.factorial : ℝ) : ℂ) *
        ∑ w : FeatureWord A m,
          conj (featureMoment μ feature f w) *
            featureMoment μ feature h w) := by
  calc
    _ = ∫ z : X × X,
        ∑' m : ℕ, featureTaylorIntegrand alpha feature f h m z
          ∂μ.prod μ := by
      apply integral_congr_ae
      filter_upwards with z
      exact (tsum_featureTaylorIntegrand_apply alpha feature f h z).symm
    _ = ∑' m : ℕ, ∫ z,
        featureTaylorIntegrand alpha feature f h m z ∂μ.prod μ :=
      (tsum_integral_featureTaylorIntegrand μ alpha feature f h).symm
    _ = _ := by
      apply tsum_congr
      intro m
      exact integral_featureTaylorIntegrand_eq_gram μ alpha feature f h m

/-- The real nonnegative degree-`m` moment mass on the diagonal. -/
def featureMomentNormSeriesTerm
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f : C(X, ℂ))
    (m : ℕ) : ℝ :=
  (alpha ^ m / m.factorial) *
    ∑ w : FeatureWord A m, ‖featureMoment μ feature f w‖ ^ 2

/-- Normal convergence of the kernel implies summability of the real
diagonal moment-mass series. -/
theorem summable_featureMomentNormSeriesTerm
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f : C(X, ℂ)) :
    Summable (featureMomentNormSeriesTerm μ alpha feature f) := by
  have hnorm := summable_norm_featureTaylorIntegrand alpha feature f f
  have hint : Summable fun m : ℕ ↦
      ∫ z, featureTaylorIntegrand alpha feature f f m z ∂μ.prod μ := by
    apply Summable.of_norm
    refine hnorm.of_nonneg_of_le (fun m ↦ norm_nonneg _) (fun m ↦ ?_)
    calc
      ‖∫ z, featureTaylorIntegrand alpha feature f f m z ∂μ.prod μ‖ ≤
          ∫ z, ‖featureTaylorIntegrand alpha feature f f m z‖ ∂μ.prod μ :=
        norm_integral_le_integral_norm _
      _ ≤ ∫ _z, ‖featureTaylorIntegrand alpha feature f f m‖ ∂μ.prod μ := by
        apply integral_mono
        · exact (featureTaylorIntegrand alpha feature f f m).continuous.norm
            |>.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
        · exact integrable_const _
        · intro z
          exact (featureTaylorIntegrand alpha feature f f m).norm_coe_le_norm z
      _ = _ := by simp
  have hcomplex : Summable fun m : ℕ ↦
      ((featureMomentNormSeriesTerm μ alpha feature f m : ℝ) : ℂ) := by
    apply hint.congr
    intro m
    rw [integral_featureTaylorIntegrand_eq_gram]
    rw [show (∑ w : FeatureWord A m,
        conj (featureMoment μ feature f w) * featureMoment μ feature f w) =
        ((∑ w : FeatureWord A m,
          ‖featureMoment μ feature f w‖ ^ 2 : ℝ) : ℂ) by
      push_cast
      apply Finset.sum_congr rfl
      intro w _hw
      rw [Complex.conj_mul']]
    unfold featureMomentNormSeriesTerm
    push_cast
    ring
  exact Complex.summable_ofReal.mp hcomplex

/-- Real form of the exact diagonal exponential-kernel expansion. -/
theorem re_expFeatureKernel_pairing_self_eq_tsum_normSeries
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f : C(X, ℂ)) :
    Complex.re (∫ z : X × X,
      featureSideFactor f f z * expFeatureKernel alpha feature z
        ∂μ.prod μ) =
      ∑' m : ℕ, featureMomentNormSeriesTerm μ alpha feature f m := by
  rw [expFeatureKernel_pairing_eq_tsum_moments μ alpha feature f f]
  have hs := summable_featureMomentNormSeriesTerm μ alpha feature f
  have hterm (m : ℕ) :
      (((alpha ^ m / m.factorial : ℝ) : ℂ) *
        ∑ w : FeatureWord A m,
          conj (featureMoment μ feature f w) *
            featureMoment μ feature f w) =
      ((featureMomentNormSeriesTerm μ alpha feature f m : ℝ) : ℂ) := by
    rw [show (∑ w : FeatureWord A m,
        conj (featureMoment μ feature f w) * featureMoment μ feature f w) =
        ((∑ w : FeatureWord A m,
          ‖featureMoment μ feature f w‖ ^ 2 : ℝ) : ℂ) by
      push_cast
      apply Finset.sum_congr rfl
      intro w _hw
      rw [Complex.conj_mul']]
    unfold featureMomentNormSeriesTerm
    push_cast
    ring
  have hcomplex : Summable fun m : ℕ ↦
      (((alpha ^ m / m.factorial : ℝ) : ℂ) *
        ∑ w : FeatureWord A m,
          conj (featureMoment μ feature f w) *
            featureMoment μ feature f w) := by
    apply (Complex.summable_ofReal.mpr hs).congr
    intro m
    exact (hterm m).symm
  rw [Complex.re_tsum hcomplex]
  apply tsum_congr
  intro m
  rw [hterm]
  rfl

/-- On the diagonal and at nonnegative coupling, every term of the exact
moment expansion is nonnegative. -/
theorem expFeatureKernel_pairing_self_nonneg
    {alpha : ℝ} (halpha : 0 ≤ alpha)
    (feature : A → C(X, ℂ)) (f : C(X, ℂ)) :
    Complex.im (∫ z : X × X,
      featureSideFactor f f z * expFeatureKernel alpha feature z
        ∂μ.prod μ) = 0 ∧
      0 ≤ Complex.re (∫ z : X × X,
        featureSideFactor f f z * expFeatureKernel alpha feature z
          ∂μ.prod μ) := by
  rw [expFeatureKernel_pairing_eq_tsum_moments μ alpha feature f f]
  let term : ℕ → ℂ := fun m ↦
    (((alpha ^ m / m.factorial : ℝ) : ℂ) *
      ∑ w : FeatureWord A m,
        conj (featureMoment μ feature f w) * featureMoment μ feature f w)
  have hterm (m : ℕ) : term m =
      (((alpha ^ m / m.factorial) *
        ∑ w : FeatureWord A m, ‖featureMoment μ feature f w‖ ^ 2 : ℝ) : ℂ) := by
    unfold term
    rw [show (∑ w : FeatureWord A m,
        conj (featureMoment μ feature f w) * featureMoment μ feature f w) =
        ((∑ w : FeatureWord A m, ‖featureMoment μ feature f w‖ ^ 2 : ℝ) : ℂ) by
      push_cast
      apply Finset.sum_congr rfl
      intro w _hw
      rw [Complex.conj_mul']]
    push_cast
    ring
  have hsummable : Summable term := by
    have hnorm := summable_norm_featureTaylorIntegrand alpha feature f f
    have hint : Summable fun m : ℕ ↦
        ∫ z, featureTaylorIntegrand alpha feature f f m z ∂μ.prod μ := by
      apply Summable.of_norm
      refine hnorm.of_nonneg_of_le (fun m ↦ norm_nonneg _) (fun m ↦ ?_)
      calc
        ‖∫ z, featureTaylorIntegrand alpha feature f f m z ∂μ.prod μ‖ ≤
            ∫ z, ‖featureTaylorIntegrand alpha feature f f m z‖ ∂μ.prod μ :=
          norm_integral_le_integral_norm _
        _ ≤ ∫ _z, ‖featureTaylorIntegrand alpha feature f f m‖ ∂μ.prod μ := by
          apply integral_mono
          · exact (featureTaylorIntegrand alpha feature f f m).continuous.norm
              |>.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
          · exact integrable_const _
          · intro z
            exact (featureTaylorIntegrand alpha feature f f m).norm_coe_le_norm z
        _ = _ := by simp
    exact hint.congr fun m ↦
      integral_featureTaylorIntegrand_eq_gram μ alpha feature f f m
  constructor
  · rw [Complex.im_tsum hsummable]
    exact HasSum.tsum_eq <| HasSum.congr_fun hasSum_zero fun m ↦ by
      rw [hterm]
      rfl
  · rw [Complex.re_tsum hsummable]
    apply tsum_nonneg
    intro m
    rw [hterm]
    exact mul_nonneg (div_nonneg (pow_nonneg halpha m) (Nat.cast_nonneg _))
      (Finset.sum_nonneg fun _ _ ↦ sq_nonneg _)

/-! ## Finite-dimensional vector-valued endpoints

The repository represents endpoint vectors by a finite coordinate family.
Summing the scalar theorem over those coordinates is the basis realization
of the vector-valued tensor theorem in the roadmap. -/

variable {I : Type*} [Fintype I]

/-- Coordinate expression for the Hermitian pairing of two finite endpoint
families. -/
def familyFeatureSideFactor (f h : I → C(X, ℂ)) : C(X × X, ℂ) :=
  ∑ i, featureSideFactor (f i) (h i)

@[simp]
theorem familyFeatureSideFactor_apply (f h : I → C(X, ℂ)) (z : X × X) :
    familyFeatureSideFactor f h z =
      ∑ i, conj (f i z.1) * h i z.2 := by
  simp [familyFeatureSideFactor]

/-- Exact vector-valued exponential-kernel expansion, expressed in any
finite coordinate basis of the endpoint space. -/
theorem familyExpFeatureKernel_pairing_eq_sum_tsum_moments
    (alpha : ℝ) (feature : A → C(X, ℂ)) (f h : I → C(X, ℂ)) :
    (∫ z : X × X,
      familyFeatureSideFactor f h z * expFeatureKernel alpha feature z
        ∂μ.prod μ) =
      ∑ i, ∑' m : ℕ, (((alpha ^ m / m.factorial : ℝ) : ℂ) *
        ∑ w : FeatureWord A m,
          conj (featureMoment μ feature (f i) w) *
            featureMoment μ feature (h i) w) := by
  rw [show (∫ z : X × X,
      familyFeatureSideFactor f h z * expFeatureKernel alpha feature z
        ∂μ.prod μ) =
      ∑ i, ∫ z : X × X,
        featureSideFactor (f i) (h i) z *
          expFeatureKernel alpha feature z ∂μ.prod μ by
    simp only [familyFeatureSideFactor, ContinuousMap.sum_apply,
      Finset.sum_mul]
    rw [integral_finsetSum]
    intro i _hi
    exact ((featureSideFactor (f i) (h i)).continuous.mul
      (expFeatureKernel alpha feature).continuous)
      |>.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)]
  apply Finset.sum_congr rfl
  intro i _hi
  exact expFeatureKernel_pairing_eq_tsum_moments
    μ alpha feature (f i) (h i)

/-- A vector endpoint gives a real nonnegative exponential-kernel quadratic
form at every nonnegative coupling. -/
theorem familyExpFeatureKernel_pairing_self_nonneg
    {alpha : ℝ} (halpha : 0 ≤ alpha)
    (feature : A → C(X, ℂ)) (f : I → C(X, ℂ)) :
    Complex.im (∫ z : X × X,
      familyFeatureSideFactor f f z * expFeatureKernel alpha feature z
        ∂μ.prod μ) = 0 ∧
      0 ≤ Complex.re (∫ z : X × X,
        familyFeatureSideFactor f f z * expFeatureKernel alpha feature z
          ∂μ.prod μ) := by
  have hsplit : (∫ z : X × X,
      familyFeatureSideFactor f f z * expFeatureKernel alpha feature z
        ∂μ.prod μ) =
      ∑ i, ∫ z : X × X,
        featureSideFactor (f i) (f i) z * expFeatureKernel alpha feature z
          ∂μ.prod μ := by
    simp only [familyFeatureSideFactor, ContinuousMap.sum_apply,
      Finset.sum_mul]
    rw [integral_finsetSum]
    intro i _hi
    exact ((featureSideFactor (f i) (f i)).continuous.mul
      (expFeatureKernel alpha feature).continuous)
      |>.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  rw [hsplit]
  constructor
  · change Complex.imAddGroupHom (∑ i, ∫ z : X × X,
        featureSideFactor (f i) (f i) z * expFeatureKernel alpha feature z
          ∂μ.prod μ) = 0
    rw [map_sum]
    exact Finset.sum_eq_zero fun i _hi ↦
      (expFeatureKernel_pairing_self_nonneg μ halpha feature (f i)).1
  · change 0 ≤ Complex.reAddGroupHom (∑ i, ∫ z : X × X,
        featureSideFactor (f i) (f i) z * expFeatureKernel alpha feature z
          ∂μ.prod μ)
    rw [map_sum]
    exact Finset.sum_nonneg fun i _hi ↦
      (expFeatureKernel_pairing_self_nonneg μ halpha feature (f i)).2

/-! ## Exact splitting into fixed endpoint and remote features -/

variable {E R : Type*} [Fintype E] [Fintype R]

/-- Combine two disjoint finite coordinate families. -/
def sumFeature (featureE : E → C(X, ℂ)) (featureR : R → C(X, ℂ)) :
    E ⊕ R → C(X, ℂ)
  | Sum.inl e => featureE e
  | Sum.inr r => featureR r

@[simp]
theorem sumFeature_inl (featureE : E → C(X, ℂ)) (featureR : R → C(X, ℂ))
    (e : E) : sumFeature featureE featureR (Sum.inl e) = featureE e :=
  rfl

@[simp]
theorem sumFeature_inr (featureE : E → C(X, ℂ)) (featureR : R → C(X, ℂ))
    (r : R) : sumFeature featureE featureR (Sum.inr r) = featureR r :=
  rfl

/-- The rank-one kernel of a disjoint union is the sum of the two kernels. -/
theorem featureKernel_sumFeature
    (featureE : E → C(X, ℂ)) (featureR : R → C(X, ℂ)) :
    featureKernel (sumFeature featureE featureR) =
      featureKernel featureE + featureKernel featureR := by
  ext z
  simp only [featureKernel_apply, ContinuousMap.add_apply]
  rw [Fintype.sum_sum_type]
  rfl

/-- Consequently the exponential kernel factors exactly across a disjoint
endpoint/remote split.  No normalization constant is introduced. -/
theorem expFeatureKernel_sumFeature
    (alpha : ℝ) (featureE : E → C(X, ℂ)) (featureR : R → C(X, ℂ)) :
    expFeatureKernel alpha (sumFeature featureE featureR) =
      expFeatureKernel alpha featureE * expFeatureKernel alpha featureR := by
  ext z
  rw [expFeatureKernel_apply, featureKernel_sumFeature]
  simp only [ContinuousMap.add_apply, ContinuousMap.mul_apply]
  rw [mul_add, Complex.exp_add]
  rfl

/-! ## Adapter to the existing Wilson crossing kernel -/

open Gauge

variable {G C P Q : Type*} {s : ℕ}
  [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [Fintype Q]

/-- The abstract finite coordinate family instantiated by the oriented
Wilson matrix coefficients already used in link reflection positivity. -/
def wilsonCrossFeature
    (D : LinkReflection.WilsonActionDecomposition G s C P Q)
    (a : LinkReflection.WilsonActionDecomposition.CrossLetter Q s) :
    C(LinkReflection.SideConfiguration G P, ℂ) where
  toFun U := D.crossFeature a U
  continuous_toFun := D.continuous_crossFeature a

/-- The abstract feature kernel is definitionally the repository's Wilson
crossing kernel. -/
theorem featureKernel_wilsonCrossFeature
    (D : LinkReflection.WilsonActionDecomposition G s C P Q) :
    featureKernel (wilsonCrossFeature D) = D.crossKernel := by
  ext z
  simp [featureKernel, wilsonCrossFeature,
    LinkReflection.WilsonActionDecomposition.crossKernel]

/-- Exact Wilson-action normalization of the abstract exponential kernel.
The factor is `beta / (2 * dim sigma)`, matching `wilsonPotential`. -/
theorem expFeatureKernel_wilsonCrossFeature_apply
    (D : LinkReflection.WilsonActionDecomposition G s C P Q)
    (beta : ℝ) (z : LinkReflection.SideConfiguration G P ×
      LinkReflection.SideConfiguration G P) :
    expFeatureKernel (beta / (2 * s : ℝ)) (wilsonCrossFeature D) z =
      Complex.exp ((beta * ∑ q : Q, D.representation.wilsonPotential
        (D.crossHolonomy q z.2 * (D.crossHolonomy q z.1)⁻¹) : ℝ) : ℂ) := by
  rw [expFeatureKernel_apply, featureKernel_wilsonCrossFeature]
  apply congrArg Complex.exp
  have hcross := D.sum_wilsonPotential_eq_crossKernel z
  push_cast
  rw [hcross]
  ring

end

