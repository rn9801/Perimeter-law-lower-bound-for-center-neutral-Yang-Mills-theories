import GluelumpPerimeterLaw.Propagation.ConjSpanCornerEndpoints
import GluelumpPerimeterLaw.Propagation.ConjSpanPhysicalStraightExpectation
import GluelumpPerimeterLaw.Propagation.CornerReflectionState
import GluelumpPerimeterLaw.Propagation.CanonicalRectangleExpectation
import GluelumpPerimeterLaw.Propagation.CofinalRectangleCertificate

/-!
# Direct conjugation-span corner expectations

This neutral module specializes diagonal bending and anti-diagonal closing to
the direct conjugation-span endpoint.  The affine placement keeps the odd
physical straight line literally equal to the Task 3 line family.  The only
geometric cutoff is the fixed collar condition `m ≤ length`.
-/

namespace YangMills.Gluelump.Propagation

open MeasureTheory YangMills.Gauge YangMills.Lattice.Cubic YangMills.Wilson
  Endpoint OneLink
open RepresentationTheory Representation

noncomputable section

universe u

variable {d m n r : ℕ} {G : Type u}
  [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [T2Space G] [MeasurableSpace G] [BorelSpace G]
  [SecondCountableTopology G] [YangMills.Gauge.GaugeHaarProbability G]

/-- The L-shaped observable produced by bending an affine straight arm with
left radius `s` and right radius `t`. -/
def conjSpanCornerBentObservable
    (hd : 3 ≤ d) (sigma : ContinuousUnitaryRepData G n)
    (rho : ContinuousUnitaryRepData G r)
    (T : IntertwiningMap (tensorPower (conjSpanRep sigma) m)
      (asRepresentation rho).dual)
    (s t : ℕ) : LocalObservable d G :=
  let a := Geometry.armAxis hd
  let b := Geometry.transverseAxis₁ hd
  let hab := Geometry.armAxis_ne_transverseAxis₁ hd
  let Phi := conjSpanCornerFarEndpoint hd sigma rho T t
  screenedObservable rho (Phi.diagonalPullback a b (-(s : ℤ))) Phi
    (conjSpanCornerLowerLPath hab s t)

/-- The real bent expectation at physical length `length`.  For odd length,
`s=length/2` and `t=s+1`; the definition is total so it can be used directly
as the sequence field of a cofinal rectangle certificate. -/
def conjSpanCornerBentExpectation
    (mu : ProbabilityMeasure (Configuration d G))
    (hd : 3 ≤ d) (sigma : ContinuousUnitaryRepData G n)
    (rho : ContinuousUnitaryRepData G r)
    (T : IntertwiningMap (tensorPower (conjSpanRep sigma) m)
      (asRepresentation rho).dual)
    (length : ℕ) : ℝ :=
  let s := length / 2
  let t := length - s
  Complex.re (∫ A, conjSpanCornerBentObservable
    hd sigma rho T s t A ∂(mu : Measure (Configuration d G)))

/-- The real Wilson expectation around the affine square generated by the two
corner reflections. -/
def conjSpanCornerSquareExpectation
    (mu : ProbabilityMeasure (Configuration d G))
    (rho : ContinuousUnitaryRepData G r)
    {a b : Fin d} (hab : a ≠ b) (length : ℕ) : ℝ :=
  let s := length / 2
  let t := length - s
  Complex.re (∫ A, rho.wilsonLoop (conjSpanCornerSquareLoop hab s t) A
    ∂(mu : Measure (Configuration d G)))

/-- Reflect the standard origin-based square through its first coordinate.
Its direction word is exactly the affine square word before translation. -/
def conjSpanCornerSiteReflectedStandardSquare
    {a b : Fin d} (hab : a ≠ b) (length : ℕ) :
    Lattice.Cubic.Path (0 : Site d) 0 :=
  siteReflectedPathFixed a 0
    (Path.rectangleBoundary 0 a b length length)
    (by ext i; by_cases hi : i = a <;> simp [siteReflection, hi])
    (by ext i; by_cases hi : i = a <;> simp [siteReflection, hi])

@[simp]
theorem directions_conjSpanCornerSiteReflectedStandardSquare
    {a b : Fin d} (hab : a ≠ b) (length : ℕ) :
    (conjSpanCornerSiteReflectedStandardSquare hab length).directions =
      List.replicate length (.backward a) ++
      List.replicate length (.forward b) ++
      List.replicate length (.forward a) ++
      List.replicate length (.backward b) := by
  simp [conjSpanCornerSiteReflectedStandardSquare, siteReflectedPathFixed,
    SignedDirection.siteReflect, SignedDirection.forward,
    SignedDirection.backward, hab, hab.symm, List.map_append]

/-- Translate the reflected standard square to the affine right endpoint. -/
def conjSpanCornerTranslatedReflectedStandardSquare
    {a b : Fin d} (hab : a ≠ b) (s t : ℕ) :
    Lattice.Cubic.Path (conjSpanCornerFarSite a t)
      (conjSpanCornerFarSite a t) :=
  YangMills.Basic.OrientedPath.castTarget
    (YangMills.Basic.OrientedPath.castSource
      ((conjSpanCornerSiteReflectedStandardSquare hab (s + t)).translate
        (conjSpanCornerFarSite a t))
      (by simp [Lattice.Cubic.translate]))
    (by simp [Lattice.Cubic.translate])

theorem conjSpanCornerSquareLoop_eq_translatedReflectedStandardSquare
    {a b : Fin d} (hab : a ≠ b) (s t : ℕ) :
    conjSpanCornerSquareLoop hab s t =
      conjSpanCornerTranslatedReflectedStandardSquare hab s t := by
  apply Path.ext_directions
  simp [conjSpanCornerTranslatedReflectedStandardSquare]

@[simp]
theorem conjSpanCornerBentExpectation_odd
    (mu : ProbabilityMeasure (Configuration d G))
    (hd : 3 ≤ d) (sigma : ContinuousUnitaryRepData G n)
    (rho : ContinuousUnitaryRepData G r)
    (T : IntertwiningMap (tensorPower (conjSpanRep sigma) m)
      (asRepresentation rho).dual)
    (l : ℕ) :
    conjSpanCornerBentExpectation mu hd sigma rho T (2 * l + 1) =
      Complex.re (∫ A, conjSpanCornerBentObservable
        hd sigma rho T l (l + 1) A
          ∂(mu : Measure (Configuration d G))) := by
  have hs : (2 * l + 1) / 2 = l := by omega
  have ht : 2 * l + 1 - l = l + 1 := by omega
  simp [conjSpanCornerBentExpectation, hs, ht]

@[simp]
theorem conjSpanCornerSquareExpectation_odd
    (mu : ProbabilityMeasure (Configuration d G))
    (rho : ContinuousUnitaryRepData G r)
    {a b : Fin d} (hab : a ≠ b) (l : ℕ) :
    conjSpanCornerSquareExpectation mu rho hab (2 * l + 1) =
      Complex.re (∫ A, rho.wilsonLoop
        (conjSpanCornerSquareLoop hab l (l + 1)) A
          ∂(mu : Measure (Configuration d G))) := by
  have hs : (2 * l + 1) / 2 = l := by omega
  have ht : 2 * l + 1 - l = l + 1 := by omega
  unfold conjSpanCornerSquareExpectation
  rw [hs]
  dsimp only
  rw [ht]

/-- The source cast in the geometric lower L does not alter the screened
observable produced by diagonal row bending. -/
theorem screenedObservable_conjSpanCornerLowerLPath_apply
    (hd : 3 ≤ d) (sigma : ContinuousUnitaryRepData G n)
    (rho : ContinuousUnitaryRepData G r)
    (T : IntertwiningMap (tensorPower (conjSpanRep sigma) m)
      (asRepresentation rho).dual)
    (s t : ℕ) (A : Configuration d G) :
    conjSpanCornerBentObservable hd sigma rho T s t A =
      let a := Geometry.armAxis hd
      let b := Geometry.transverseAxis₁ hd
      let hab := Geometry.armAxis_ne_transverseAxis₁ hd
      let Phi := conjSpanCornerFarEndpoint hd sigma rho T t
      let p := conjSpanCornerArmToOrigin a s t
      screenedObservable rho (Phi.diagonalPullback a b (-(s : ℤ))) Phi
        ((diagonalReflectedPathToFixed hab (-(s : ℤ)) p
          (diagonalReflection_conjSpanCornerOriginSite_fixed hab s)).comp
            p.reverse) A := by
  simp [conjSpanCornerBentObservable, conjSpanCornerLowerLPath,
    screenedObservable_apply, screenedValue, holonomy_castSource]

/-- First corner inequality for every odd physical length beyond the direct
endpoint collar: the Task 3 line expectation squares below the bent
expectation. -/
theorem conjSpanPhysicalStraightExpectation_sq_le_cornerBent_odd
    (mu : ProbabilityMeasure (Configuration d G))
    (hstate : ReflectionPositiveState mu)
    (hd : 3 ≤ d) (sigma : ContinuousUnitaryRepData G n)
    (rho : ContinuousUnitaryRepData G r)
    (T : IntertwiningMap (tensorPower (conjSpanRep sigma) m)
      (asRepresentation rho).dual)
    (l : ℕ) (hm : m ≤ 2 * l + 1) :
    conjSpanPhysicalStraightExpectation mu hd sigma rho T (0 : Site d)
        (conjSpanCornerZeroArm hd) (2 * l + 1) ^ 2 ≤
      conjSpanCornerBentExpectation mu hd sigma rho T (2 * l + 1) := by
  let a := Geometry.armAxis hd
  let b := Geometry.transverseAxis₁ hd
  let hab := Geometry.armAxis_ne_transverseAxis₁ hd
  let Phi := conjSpanCornerFarEndpoint hd sigma rho T (l + 1)
  let Xi := conjSpanOddCornerComparisonEndpoint hd sigma rho T l
  let p := conjSpanCornerArmToOrigin a l (l + 1)
  have hPhi : Phi.SupportedInDiagonalPositiveHalf a b (-(l : ℤ)) :=
    conjSpanCornerFarEndpoint_supportedInDiagonalPositiveHalf
      hd sigma rho T l (l + 1) (by omega)
  have hp : Endpoint.Path.SupportedInDiagonalPositiveHalf a b (-(l : ℤ)) p :=
    conjSpanCornerArmToOrigin_supportedInDiagonalPositiveHalf hab l (l + 1)
  have hXi : Xi.SupportedInDiagonalPositiveHalf a b (-(l : ℤ)) :=
    conjSpanOddCornerComparisonEndpoint_supportedInDiagonalPositiveHalf
      hd sigma rho T l
  have hXiNorm : ∀ A, endpointL2Norm (Xi A) ≤ 1 :=
    conjSpanOddCornerComparisonEndpoint_l2Norm_le_one hd sigma rho T l
  have hrow :=
    YangMills.Gluelump.Propagation.Gauge.ReflectionPositiveState.diagonalRowBending
      hstate rho Phi Xi hab (-(l : ℤ)) p
    (diagonalReflection_conjSpanCornerOriginSite_fixed hab l)
    hPhi hp hXi hXiNorm
  have hherm :=
    YangMills.Gluelump.Propagation.Gauge.ReflectionPositiveState.diagonalBentIntegral_eq_star_reverse
      hstate rho Phi Xi hab (-(l : ℤ)) p
    (diagonalReflection_conjSpanCornerOriginSite_fixed hab l)
    hPhi hp hXi
  let I : ℂ := ∫ A, conjSpanPhysicalStraightObservable
    hd sigma rho T (0 : Site d) (conjSpanCornerZeroArm hd) (2 * l + 1) A
      ∂(mu : Measure (Configuration d G))
  let B : ℂ := ∫ A,
    screenedObservable rho (Phi.diagonalPullback a b (-(l : ℤ))) Xi
      (diagonalReflectedPathToFixed hab (-(l : ℤ)) p
        (diagonalReflection_conjSpanCornerOriginSite_fixed hab l)) A
      ∂(mu : Measure (Configuration d G))
  have hreverse :
      (∫ A, screenedObservable rho
        (Xi.diagonalPullback a b (-(l : ℤ))) Phi p.reverse A
          ∂(mu : Measure (Configuration d G))) = I := by
    apply integral_congr_ae
    exact ae_of_all _ fun A => by
      have hXiPull : Xi.diagonalPullback a b (-(l : ℤ)) A =
          conjSpanOddCornerOriginEndpoint hd sigma rho T l A := by
        simp only [Xi, conjSpanOddCornerComparisonEndpoint,
          LocalField.diagonalPullback_apply]
        rw [diagonalReflectConfiguration_diagonalReflectConfiguration hab]
      rw [screenedObservable_apply]
      unfold screenedValue
      rw [hXiPull]
      simpa only [screenedObservable_apply, screenedValue] using
        conjSpanOddCornerStraight_reverse_apply_eq_physical
          hd sigma rho T l A
  have hBI : B = star I := by
    calc
      B = star (∫ A, screenedObservable rho
          (Xi.diagonalPullback a b (-(l : ℤ))) Phi p.reverse A
            ∂(mu : Measure (Configuration d G))) := by
        simpa [B, a, b, hab, Phi, Xi, p] using hherm
      _ = star I := congrArg star hreverse
  have hL :
      Complex.re (∫ A, screenedObservable rho
        (Phi.diagonalPullback a b (-(l : ℤ))) Phi
          ((diagonalReflectedPathToFixed hab (-(l : ℤ)) p
            (diagonalReflection_conjSpanCornerOriginSite_fixed hab l)).comp
              p.reverse) A ∂(mu : Measure (Configuration d G))) =
        conjSpanCornerBentExpectation mu hd sigma rho T (2 * l + 1) := by
    rw [conjSpanCornerBentExpectation_odd]
    apply congrArg Complex.re
    apply integral_congr_ae
    exact ae_of_all _ fun A => by
      simpa [a, b, hab, Phi, p] using
        (screenedObservable_conjSpanCornerLowerLPath_apply
          hd sigma rho T l (l + 1) A).symm
  calc
    conjSpanPhysicalStraightExpectation mu hd sigma rho T (0 : Site d)
        (conjSpanCornerZeroArm hd) (2 * l + 1) ^ 2 = I.re ^ 2 := rfl
    _ ≤ Complex.normSq I := by
      simpa [pow_two] using Complex.re_sq_le_normSq I
    _ = Complex.normSq B := by rw [hBI]; simp
    _ ≤ Complex.re (∫ A, screenedObservable rho
        (Phi.diagonalPullback a b (-(l : ℤ))) Phi
          ((diagonalReflectedPathToFixed hab (-(l : ℤ)) p
            (diagonalReflection_conjSpanCornerOriginSite_fixed hab l)).comp
              p.reverse) A ∂(mu : Measure (Configuration d G))) := hrow
    _ = _ := hL

/-- Second corner inequality: the bent expectation squares, after division
by the Wilson representation dimension, below the affine square expectation. -/
theorem conjSpanCornerBent_sq_div_dimension_le_square_odd
    (mu : ProbabilityMeasure (Configuration d G))
    (hstate : ReflectionPositiveState mu)
    (hd : 3 ≤ d) (sigma : ContinuousUnitaryRepData G n)
    (rho : ContinuousUnitaryRepData G r)
    (T : IntertwiningMap (tensorPower (conjSpanRep sigma) m)
      (asRepresentation rho).dual)
    (l : ℕ) :
    conjSpanCornerBentExpectation mu hd sigma rho T (2 * l + 1) ^ 2 /
        (r : ℝ) ≤
      conjSpanCornerSquareExpectation mu rho
        (Geometry.armAxis_ne_transverseAxis₁ hd) (2 * l + 1) := by
  let a := Geometry.armAxis hd
  let b := Geometry.transverseAxis₁ hd
  let hab := Geometry.armAxis_ne_transverseAxis₁ hd
  let Phi := conjSpanCornerFarEndpoint hd sigma rho T (l + 1)
  let Psi := Phi.diagonalPullback a b (-(l : ℤ))
  have hp : Endpoint.Path.SupportedInAntiDiagonalPositiveHalf a b (l + 1)
      (conjSpanCornerUpperLPath hab l (l + 1)) :=
    conjSpanCornerUpperLPath_supportedInAntiDiagonalPositiveHalf
      hab l (l + 1)
  have hPhi : Phi.SupportedInAntiDiagonalPositiveHalf a b (l + 1) :=
    conjSpanCornerFarEndpoint_supportedInAntiDiagonalPositiveHalf
      hd sigma rho T (l + 1)
  have hPsi : Psi.SupportedInAntiDiagonalPositiveHalf a b (l + 1) :=
    conjSpanCornerFarEndpoint_diagonalPullback_supportedInAntiDiagonalPositiveHalf
      hd sigma rho T l (l + 1)
  have hPhiNorm : ∀ A, endpointL2Norm (Phi A) ≤ 1 :=
    conjSpanCornerFarEndpoint_l2Norm_le_one hd sigma rho T (l + 1)
  have hPsiNorm : ∀ A, endpointL2Norm (Psi A) ≤ 1 := by
    intro A
    change endpointL2Norm (Phi (diagonalReflectConfiguration
      a b (-(l : ℤ)) A)) ≤ 1
    exact hPhiNorm _
  have hclose :=
    YangMills.Gluelump.Propagation.Gauge.ReflectionPositiveState.antiDiagonalMatrixClosing
      hstate rho Psi Phi hab (l + 1)
    (conjSpanCornerUpperLPath hab l (l + 1))
    (antiDiagonalReflection_conjSpanCornerUpperLeftSite_fixed hab l (l + 1))
    (antiDiagonalReflection_conjSpanCornerFarSite_fixed hab l (l + 1))
    hp hPsi hPhi hPsiNorm hPhiNorm
  have hreflect :
      antiDiagonalReflectedPathFixed hab ((l : ℤ) + 1)
        (conjSpanCornerUpperLPath hab l (l + 1))
        (antiDiagonalReflection_conjSpanCornerUpperLeftSite_fixed
          hab l (l + 1))
        (antiDiagonalReflection_conjSpanCornerFarSite_fixed
          hab l (l + 1)) =
      conjSpanCornerLowerLPath hab l (l + 1) := by
    simpa only [Nat.cast_add, Nat.cast_one] using
      antiDiagonalReflected_conjSpanCornerUpperLPath_eq_lower
        hab l (l + 1)
  rw [hreflect] at hclose
  have hBent :
      conjSpanCornerBentExpectation mu hd sigma rho T (2 * l + 1) =
        Complex.re (∫ A, screenedObservable rho Psi Phi
          (conjSpanCornerLowerLPath hab l (l + 1)) A
            ∂(mu : Measure (Configuration d G))) := by
    simp [conjSpanCornerBentExpectation_odd,
      conjSpanCornerBentObservable, a, b, hab, Phi, Psi]
  have hSq :
      conjSpanCornerSquareExpectation mu rho hab (2 * l + 1) =
        Complex.re (∫ A, rho.wilsonLoop
          (conjSpanCornerSquareLoop hab l (l + 1)) A
            ∂(mu : Measure (Configuration d G))) :=
    conjSpanCornerSquareExpectation_odd mu rho hab l
  have hrealSq :
      conjSpanCornerBentExpectation mu hd sigma rho T (2 * l + 1) ^ 2 ≤
        (r : ℝ) * conjSpanCornerSquareExpectation mu rho hab (2 * l + 1) := by
    rw [hBent, hSq]
    simpa [pow_two] using (Complex.re_sq_le_normSq _).trans (by
      simpa [conjSpanCornerSquareLoop, a, b, hab, Phi, Psi] using hclose)
  have hr : (0 : ℝ) < r := by exact_mod_cast rho.dimension_pos
  calc
    conjSpanCornerBentExpectation mu hd sigma rho T (2 * l + 1) ^ 2 /
        (r : ℝ) ≤
      ((r : ℝ) * conjSpanCornerSquareExpectation mu rho hab (2 * l + 1)) /
        (r : ℝ) := div_le_div_of_nonneg_right hrealSq hr.le
    _ = conjSpanCornerSquareExpectation mu rho hab (2 * l + 1) := by
      field_simp

/-- Translation and first-coordinate reflection identify the affine square
from corner closing with the public canonical rectangle expectation. -/
theorem conjSpanCornerSquareExpectation_eq_canonicalRectangleExpectation_odd
    (mu : ProbabilityMeasure (Configuration d G))
    (hstate : ReflectionPositiveState mu)
    (rho : ContinuousUnitaryRepData G r)
    {a b : Fin d} (hab : a ≠ b) (l : ℕ) :
    conjSpanCornerSquareExpectation mu rho hab (2 * l + 1) =
      canonicalRectangleExpectation mu rho hab (2 * l + 1) (2 * l + 1) := by
  let length := 2 * l + 1
  let v := conjSpanCornerFarSite a (l + 1)
  let F := rho.wilsonLoop
    (conjSpanCornerSiteReflectedStandardSquare hab length)
  have hlength : l + (l + 1) = length := by
    dsimp only [length]
    omega
  have htranslate := hstate.localExpectation_translatePullback v F
  have hreflect := hstate.localExpectation_siteReflectionPullback a
    (rho.wilsonLoop (Path.rectangleBoundary 0 a b length length))
  rw [conjSpanCornerSquareExpectation_odd]
  unfold canonicalRectangleExpectation
  apply congrArg Complex.re
  calc
    (∫ A, rho.wilsonLoop (conjSpanCornerSquareLoop hab l (l + 1)) A
        ∂(mu : Measure (Configuration d G))) =
      ∫ A, rho.wilsonLoop
        (conjSpanCornerTranslatedReflectedStandardSquare hab l (l + 1)) A
          ∂(mu : Measure (Configuration d G)) := by
      apply integral_congr_ae
      exact ae_of_all _ fun A => by
        rw [← conjSpanCornerSquareLoop_eq_translatedReflectedStandardSquare]
    _ = ∫ A, F (LocalObservable.translateConfiguration v A)
          ∂(mu : Measure (Configuration d G)) := by
      apply integral_congr_ae
      exact ae_of_all _ fun A => by
        simp only [F, ContinuousUnitaryRepData.wilsonLoop_apply,
          conjSpanCornerTranslatedReflectedStandardSquare,
          holonomy_castTarget, holonomy_castSource]
        simpa only [v, hlength, LocalObservable.translateConfiguration] using
          congrArg rho.normalizedCharacter
            (holonomy_translateConfiguration v A
              (conjSpanCornerSiteReflectedStandardSquare hab length)).symm
    _ = ∫ A, F A ∂(mu : Measure (Configuration d G)) := htranslate
    _ = ∫ A, rho.wilsonLoop (Path.rectangleBoundary 0 a b length length)
          (siteReflectConfiguration a 0 A)
          ∂(mu : Measure (Configuration d G)) := by
      apply integral_congr_ae
      exact ae_of_all _ fun A => by
        simp only [F, ContinuousUnitaryRepData.wilsonLoop_apply]
        unfold conjSpanCornerSiteReflectedStandardSquare
        rw [holonomy_siteReflectedPathFixed]
    _ = ∫ A, rho.wilsonLoop (Path.rectangleBoundary 0 a b length length) A
          ∂(mu : Measure (Configuration d G)) := by
      simpa only [LocalObservable.siteReflectionPullback_apply] using hreflect
    _ = canonicalRectangleIntegral mu rho hab length length :=
      (canonicalRectangleIntegral_eq_rectangleBoundaryIntegral
        hstate rho hab length length).symm

/-- Package the direct corner geometry with any neutral canonical-rectangle
certificate.  This is the exact collar-aware interface consumed by the
perimeter extrapolation theorem. -/
theorem conjSpanCofinalRectangleReflectionCertificate
    (mu : ProbabilityMeasure (Configuration d G))
    (hstate : ReflectionPositiveState mu)
    (hd : 3 ≤ d) (sigma : ContinuousUnitaryRepData G n)
    (rho : ContinuousUnitaryRepData G r)
    (T : IntertwiningMap (tensorPower (conjSpanRep sigma) m)
      (asRepresentation rho).dual)
    (hrect : CanonicalRectangleExpectationCertificate mu rho
      (Geometry.armAxis_ne_transverseAxis₁ hd)) :
    CofinalRectangleReflectionCertificate m (r : ℝ)
      (conjSpanPhysicalStraightExpectation mu hd sigma rho T (0 : Site d)
        (conjSpanCornerZeroArm hd))
      (conjSpanCornerBentExpectation mu hd sigma rho T)
      (canonicalRectangleExpectation mu rho
        (Geometry.armAxis_ne_transverseAxis₁ hd)) := by
  let hab := Geometry.armAxis_ne_transverseAxis₁ hd
  refine
    { diagonalBend := ?_
      antiDiagonalClose := ?_
      rectangleNonneg := hrect.nonnegative
      rectangleLeOne := hrect.le_one
      rectangleSideLogConvex := hrect.side_logConvex
      rectangleTranspose := hrect.transpose }
  · intro length hcut hOdd
    rcases hOdd with ⟨l, rfl⟩
    exact conjSpanPhysicalStraightExpectation_sq_le_cornerBent_odd
      mu hstate hd sigma rho T l hcut
  · intro length _hcut hOdd
    rcases hOdd with ⟨l, rfl⟩
    rw [← conjSpanCornerSquareExpectation_eq_canonicalRectangleExpectation_odd
      mu hstate rho hab l]
    exact conjSpanCornerBent_sq_div_dimension_le_square_odd
      mu hstate hd sigma rho T l

end

end YangMills.Gluelump.Propagation
